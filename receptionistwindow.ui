    <widget class="QWidget" name="contentAreaWidget" native="true">
     <property name="styleSheet">
      <string notr="true">/* Card Container Styling */
QFrame#appointments, QFrame#bedsavailable, QFrame#billspending {
    background-color: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 14px;
}

QFrame#appointments:hover, QFrame#bedsavailable:hover, QFrame#billspending:hover {
    border: 1px solid #0284C7;
}

/* Stat Titles */
QLabel#appointmentTitle, QLabel#bedsTitle, QLabel#billingTitle {
    color: #64748B;
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

/* Big Number Highlight */
QLabel#numberofappointment, QLabel#numberofavailablebeds, QLabel#numberofpendingbills {
    color: #0F172A;
    font-size: 26px;
    font-weight: bold;
}

/* Subtext / Pills */
QLabel#appointmentStatus, QLabel#bedsStatus, QLabel#billingStatus {
    color: #0284C7;
    font-size: 11px;
    font-weight: 600;
}</string>
