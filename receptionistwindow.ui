          <widget class="QFrame" name="profileContainer">
           <property name="styleSheet">
            <string notr="true">/* Container Box */
#profileContainer {
    background-color: #EBF3F5;
    border-radius: 18px;
    padding: 2px 8px;
}

/* Date Badge inside the Container */
QLabel#dateLevel, QLabel#dateLabel {
    background-color: #DEEAEF;
    color: #4A6572;
    border-radius: 12px;
    padding: 4px 10px;
    font-size: 11px;
    font-weight: 500;
}

/* Role Text */
QLabel#label_2, QLabel#roleLabel {
    color: #111A2E;
    font-size: 11px;
    font-weight: bold;
    letter-spacing: 0.5px;
}

/* Hamburger / Menu Button */
QPushButton#btnMenu {
    background-color: transparent;
    border: none;
    color: #111A2E;
    font-size: 18px;
    font-weight: bold;
}

QPushButton#btnMenu:hover {
    background-color: #D3E2E6;
    border-radius: 6px;
}</string>
