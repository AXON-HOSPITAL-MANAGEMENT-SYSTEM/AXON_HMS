      <string notr="true">/* Sidebar Buttons */
QPushButton#btnDashboard,
QPushButton#btnRegisterPatient,
QPushButton#btnSchedule,
QPushButton#btnBilling {
    background-color: #E2ECEF;
    color: #111A2E;
    border: none;
    border-radius: 8px;
    padding: 10px 15px;
    font-size: 13px;
    font-weight: bold;
    text-align: left;
    min-height: 40px;
}

QPushButton#btnDashboard:hover,
QPushButton#btnRegisterPatient:hover,
QPushButton#btnSchedule:hover,
QPushButton#btnBilling:hover {
    background-color: #D3E2E6;
    color: #0055A4;
}</string>
